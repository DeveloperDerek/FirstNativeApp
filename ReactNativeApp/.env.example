# Copy to .env and fill in. Never commit .env.
# Only the publishable (anon) key belongs here - never the service_role key.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-publishable-or-anon-key

# Public URL of your privacy policy (shown on the consent and profile screens)
EXPO_PUBLIC_PRIVACY_URL=https://yourdomain.com/privacy

# Support email, shown on the "account paused" screen
EXPO_PUBLIC_SUPPORT_EMAIL=

# Optional sign-in providers. Leave blank to hide the button.
# After changing these, run: npx expo prebuild --clean
# Apple: requires a paid Apple Developer account.
EXPO_PUBLIC_APPLE_SIGN_IN=false
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Apple Developer team ID used to sign builds for your iPhone
# (Xcode > Settings > Accounts, or the OU= field of your Apple Development certificate)
APPLE_TEAM_ID=

# Push notifications (step-tracker-notifications.txt, Phase 3). Needs a
# paid Apple Developer account and an EAS project; see app.config.ts.
EXPO_PUBLIC_PUSH_NOTIFICATIONS=false
EXPO_PUBLIC_EAS_PROJECT_ID=
